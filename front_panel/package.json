{
    "name": "front_panel",
    "version": "1.1.0",
    "description": "Watch Dog front panel: static host and WebSocket proxy for the engine",
    "private": true,
    "license": "GPL-3.0-or-later",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "start": "node server/index.js",
        "dev": "nodemon server/index.js",
        "build": "webpack --mode production",
        "build:dev": "webpack --mode development --watch",
        "launch:prebuilt": "node scripts/launch.js --engine prebuilt",
        "launch:source": "node scripts/launch.js --engine source",
        "launch:none": "node scripts/launch.js --engine none",
        "launch": "npm run launch:source",
        "launchWin": "npm run launch:source",
        "watch_dog": "npm run launch:prebuilt",
        "watch_dog_win": "npm run launch:prebuilt",
        "watch_dog_mac": "npm run launch:prebuilt",
        "build_dev": "npm run build:dev",
        "buildAndLaunch": "npm run build && npm run launch:prebuilt"
    },
    "dependencies": {
        "express": "^4.21.0",
        "http-proxy-middleware": "^3.0.2"
    },
    "devDependencies": {
        "@types/express": "^5.0.0",
        "@types/node": "^22.7.4",
        "chart.js": "^4.4.7",
        "chartjs-plugin-zoom": "^2.2.0",
        "nodemon": "^3.1.7",
        "three": "^0.170.0",
        "webpack": "^5.96.1",
        "webpack-cli": "^5.1.4"
    }
}
